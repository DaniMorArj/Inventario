# Variables de entorno de InventarioApp.
# En tu hosting se definen en el panel de la aplicación (Environment Variables).
# En local las gestiona docker-compose.yml. NO pongas valores reales en este fichero.

# --- Base de datos (MariaDB/MySQL) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=inventario
DB_USER=inventario
DB_PASS=

# --- URL publica de la app (para los enlaces de los correos, detras del proxy) ---
APP_BASE_URL=https://tu-dominio.example.com

# --- SMTP (recuperacion de contrasena) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=InventarioApp

# --- Muro de acceso a la demo publica (ver CLAUDE.md) ---
# Vacio = sin muro (comodo en local). Ponle un valor antes de publicar la demo.
APP_LOGIN_PASSWORD=
